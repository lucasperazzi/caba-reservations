{
  "buildCommand": "npm run build --workspace backend && npm run build --workspace frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.ts": {
      "memory": 256
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
